{
  "name": "apexos-web-movil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:qa": "tsc -b && vite build --mode qa",
    "preview": "vite preview",
    "preview:qa": "vite preview --mode qa",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "mock-api": "node scripts/mock-api.mjs",
    "dev:mock": "vite --mode mock",
    "dev:celular": "vite --host",
    "dev:celular:mock": "vite --host --mode mock",
    "models": "node scripts/copy-human-models.mjs",
    "predev": "node scripts/copy-human-models.mjs",
    "prebuild": "node scripts/copy-human-models.mjs",
    "prebuild:qa": "node scripts/copy-human-models.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "@vladmandic/human": "3.3.6",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
